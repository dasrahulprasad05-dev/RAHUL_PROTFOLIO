# ==========================================
# Frontend Environment Variables (.env.local)
# ==========================================

# 1. AI Portfolio Assistant (Vercel Serverless)
# Add this in Vercel Settings -> Environment Variables
LLM_API_KEY="your-gemini-api-key-here"
LLM_MODEL="gemini-3.1-flash-lite"

# 2. External Backend URL (Optional)
# In local development: defaults to http://localhost:5000/api
# In production on Vercel: defaults to /api (internal serverless route)
# If you host the Express backend on Railway or Render, uncomment:
# NEXT_PUBLIC_API_URL="https://your-backend.up.railway.app/api"
# BACKEND_URL="https://your-backend.up.railway.app/api"

